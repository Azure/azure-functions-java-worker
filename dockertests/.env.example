# Azure Functions Test Environment Configuration
# Copy this file to .env and customize for your environment

# Runtime Configuration
FUNCTIONS_TEST_RUNTIME=java
FUNCTIONS_TEST_RUNTIME_VERSION=21
FUNCTIONS_TEST_HOST_VERSION=4

# Worker Directory (optional)
# Set this to mount a custom worker for development/testing
# If not set, the container will use its built-in worker
# Example: FUNCTIONS_TEST_WORKER_DIR=D:\path\to\azure-functions-java-worker\java
FUNCTIONS_TEST_WORKER_DIR=

# App Directory (optional)
# Directory containing app packages (.zip or .squashfs files)
# Default: ./apps
FUNCTIONS_TEST_APPS_DIR=./apps

# Storage Configuration (optional)
# Use Azurite by default (true) or real Azure Storage (false)
FUNCTIONS_TEST_USE_AZURITE=true

# Real Azure Storage Connection String (only needed if USE_AZURITE=false)
# FUNCTIONS_TEST_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# Notes:
# - All parameters are optional and have sensible defaults
# - Leave FUNCTIONS_TEST_WORKER_DIR empty to use the built-in worker from the image
# - Set FUNCTIONS_TEST_WORKER_DIR to a path to mount your custom worker

